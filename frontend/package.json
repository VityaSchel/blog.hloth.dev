	"author": "Viktor Shchelochkov <hi@hloth.dev> (https://hloth.dev)",
	"license": "MIT",
	"scripts": {
		"dev": "bun --env-file .env.development --bun astro dev",
		"build": "bun --env-file .env.production --bun astro build && rm -rf dist && mv dist-new dist",
		"preview": "bun --env-file .env.production --bun astro build && bun --bun astro preview",
		"astro": "astro",
		"prefetch-previews": "bun tools/prefetch-previews.ts src/content",
		"test": "bun test src/lib",
		"check": "astro check",
		"build:check": "bun --env-file .env.production --bun astro build"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "7.3.5",
