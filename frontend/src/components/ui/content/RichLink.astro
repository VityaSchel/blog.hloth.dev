---
/**
 * Example usage:
 *
 * <RichLink url="https://example.com" />
 *
 * Title, description and image come from the posts' previews/ folder
 * (bun run prefetch-previews), so the build makes no network requests.
 */

import { getImage } from "astro:assets";
import { linkPreview } from "$lib/embed/previews";

interface Props {
	url: string;
}

let { url } = Astro.props;

const preview = linkPreview(url);
const image = preview.image
	? await getImage({
			src: preview.image,
			width: 130,
			height: 130,
			fit: "cover",
			format: "avif",
		})
	: undefined;
---

<div class="rich-link py-[0.4em]">
	<a
		href={url}
		rel="noopener noreferrer nofollow"
		target="_blank"
		class="box-shadow rich-link block rounded-md bg-white p-[25px]
			has-[img]:min-h-[115px] dark:bg-black-alt"
	>
		{
			image && (
				<img
					src={image.src}
					alt="Website banner"
					class="float-right ml-2 aspect-square w-[65px] rounded-[3px]
						object-cover"
				/>
			)
		}
		<span
			class="block flex-1 text-[17px] leading-[1.5em] font-semibold
				wrap-break-word no-underline"
		>
			{preview.title || url}
		</span>
		{
			preview.description && (
				<p class="line-clamp-3 font-text text-[15px]">{preview.description}</p>
			)
		}
		<span
			class="block text-[15px] leading-tight text-[#888] dark:text-cream-alt"
		>
			{preview.siteName}
		</span>
	</a>
</div>

<style>
	.box-shadow {
		box-shadow: 0 1px 3px #0000001a;
		&:hover {
			box-shadow: 0 0 3px #00000029;
		}
	}
</style>
