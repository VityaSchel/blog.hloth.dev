---
/**
 * Example usage:
 *
 * <Embed url="https://www.youtube.com/embed/dQw4w9WgXcQ">Caption</Embed>
 * <Embed url="https://example.org" service="Example" ar={16/9} />
 *
 * YouTube and Spotify previews come from the posts' previews/ folder
 * (bun run prefetch-previews), so the build makes no network requests.
 */

import IsolatedIframe from "$ui/IsolatedIframe.svelte";
import type { GetImageResult } from "astro";
import { getImage } from "astro:assets";
import { resolveEmbed } from "$lib/embed/services";
import { embedPreview } from "$lib/embed/previews";

interface Props {
	url: string;
	service?: string;
	ar?: number | null;
	children?: Element;
}

const { url, service, ar = 16 / 9 } = Astro.props;
const embed = resolveEmbed(url, service, ar);

const compact = embed.aspectRatio === null;
const thumbnailWidth = compact ? 240 : 640;

let preview:
	| { title: string; subtitle?: string; thumbnail: GetImageResult }
	| undefined;
if (embed.preview) {
	const cached = embedPreview(embed.preview, url);
	preview = {
		title: cached.title,
		subtitle: cached.subtitle,
		thumbnail: await getImage({
			src: cached.image,
			width: thumbnailWidth,
			format: "avif",
			height: compact
				? thumbnailWidth
				: Math.round(thumbnailWidth / (embed.aspectRatio ?? 1)),
			fit: "cover",
		}),
	};
}

const frame = {
	url: embed.url,
	link: embed.link,
	compact,
	aspectRatio: embed.aspectRatio,
	name: embed.service,
	serviceId: embed.serviceId,
	referrer: embed.service === "YouTube",
	privacyPolicy: embed.privacyPolicy,
	preview,
	containerClass: { "rounded-xl h-[152px]": embed.service === "Spotify" },
};
---

{
	Astro.slots.has("default") ? (
		<IsolatedIframe {...frame} client:visible>
			<slot />
		</IsolatedIframe>
	) : (
		<IsolatedIframe {...frame} client:visible />
	)
}
