---
/**
 * Example usage:
 *
 * <Embed url="https://www.youtube.com/embed/dQw4w9WgXcQ">Caption</Embed>
 * <Embed url="https://example.org" service="Example" ar={16/9} />
 */

import IsolatedIframe from "$ui/IsolatedIframe.svelte";
import type { GetImageResult } from "astro";
import { getImage } from "astro:assets";
import siteConfig from "astro.config.mjs";
import { isRemoteAllowed } from "@astrojs/internal-helpers/remote";
import { resolveEmbed } from "$lib/embed/services";
import { getEmbedPreview } from "$lib/embed/preview";

interface Props {
	url: string;
	service?: string;
	ar?: number | null;
	children?: Element;
}

const { url, service, ar = 16 / 9 } = Astro.props;
const embed = resolveEmbed(url, service, ar);

const previewData = embed.oembedUrl
	? await getEmbedPreview(embed.oembedUrl, embed.thumbnailCandidates)
	: null;

let preview: { title: string; thumbnail: GetImageResult } | undefined;
if (previewData) {
	const allowed = isRemoteAllowed(previewData.thumbnailUrl, {
		domains: siteConfig.image?.domains || [],
		remotePatterns: siteConfig.image?.remotePatterns || [],
	});
	if (allowed) {
		preview = {
			title: previewData.title,
			thumbnail: await getImage({
				src: previewData.thumbnailUrl,
				width: 640,
				format: "avif",
				height: embed.aspectRatio
					? Math.round(640 / embed.aspectRatio)
					: undefined,
				fit: "cover",
			}),
		};
	} else {
		console.warn(
			`Remote thumbnail in Embed preview is not allowed from ${new URL(previewData.thumbnailUrl).hostname}`,
		);
	}
}

const frame = {
	url: embed.url,
	aspectRatio: embed.aspectRatio,
	name: embed.service,
	serviceId: embed.serviceId,
	referrer: embed.service === "YouTube",
	privacyPolicy: embed.privacyPolicy,
	preview,
	containerClass: { "rounded-xl h-[152px]": embed.service === "Spotify" },
};
---

{
	Astro.slots.has("default") ? (
		<IsolatedIframe {...frame} client:visible>
			<slot />
		</IsolatedIframe>
	) : (
		<IsolatedIframe {...frame} client:visible />
	)
}
