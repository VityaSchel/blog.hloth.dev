---
import type { ImageMetadata } from "astro";
import type { ComponentProps } from "astro/types";
import { Picture } from "astro:assets";
import { getLqip, type Lqip } from "$lib/get-image-as-buffer";
import { hdrSource } from "$lib/hdr/sources";
import HdrPicture from "$ui/HdrPicture.astro";

type Props = Pick<
	ComponentProps<typeof Picture>,
	"width" | "height" | "priority" | "class" | "alt"
> & {
	src: ImageMetadata;
	banner?: boolean;
	content?: boolean;
	zoomable?: boolean;
};

let {
	banner,
	class: className = "not-in-[.panorama]:rounded-lg",
	content,
	zoomable,
	...props
} = Astro.props;

let lqip: Lqip = await getLqip(props.src, {
	origin: Astro.url.origin,
});

let aspectRatio: number | null = null;
if (banner) {
	aspectRatio = 1.625 / 1;
} else if (props.src.width !== undefined && props.src.height !== undefined) {
	aspectRatio = props.src.width / props.src.height;
}

const lqipWidth = Number(props.width ?? lqip.width ?? props.src.width);
const lqipHeight =
	banner && aspectRatio !== null
		? lqipWidth / aspectRatio
		: Number(props.height ?? lqip.height ?? props.src.height);

const Element = zoomable ? "a" : "div";

const hdr = await hdrSource(props.src, lqipWidth);
const PictureElement = (hdr ? HdrPicture : Picture) as typeof Picture;
const hdrProps = hdr ? { hdr } : {};

const CONTENT_WIDTHS = [240, 360, 480, 680, 1020, 1360];
const displayWidth =
	aspectRatio !== null && aspectRatio <= 1
		? Math.min(lqipWidth, Math.round(aspectRatio * 500))
		: lqipWidth;
const responsiveWidths = [
	...new Set([...CONTENT_WIDTHS, displayWidth, displayWidth * 2]),
]
	.filter((width) => width <= Math.min(props.src.width, displayWidth * 2))
	.sort((a, b) => a - b);
const srcsetProps =
	zoomable && !banner && !hdr && lqipWidth <= 680 && responsiveWidths.length > 1
		? {
				widths: responsiveWidths,
				sizes: `min(${displayWidth}px, 100vw - 3rem)`,
			}
		: { densities: [1, 2] };
---

<script>
	const onLoad = () => {
		const lazyImages = Array.from(document.querySelectorAll(".lazy-image"));
		for (const picture of lazyImages) {
			if (!(picture instanceof HTMLPictureElement)) continue;
			const img = picture.querySelector(":scope img");
			if (!(img instanceof HTMLImageElement)) continue;
			if (img.complete) {
				img.classList.remove("ph");
			} else {
				img.addEventListener("load", () => {
					img.classList.remove("ph");
				});
			}
		}
	};

	document.addEventListener("astro:page-load", onLoad);
	document.addEventListener("load", onLoad);
	onLoad();
</script>

<Element
	class:list={[
		`img-container relative max-w-full overflow-clip
		not-in-[.panorama]:rounded-lg in-[.panorama]:w-full`,
		{
			"max-h-[inherit]": content,
			"banner-clip relative h-auto w-full overflow-clip": banner,
			wide: aspectRatio != null && aspectRatio >= 680 / 500,
			landscape:
				aspectRatio != null && aspectRatio > 1 && aspectRatio < 680 / 500,
			portrait: aspectRatio != null && aspectRatio <= 1, //680 / 500,
		},
	]}
	style={aspectRatio != null ? `aspect-ratio: ${aspectRatio};` : undefined}
	{...zoomable
		? { href: props.src.src, target: "_blank", rel: "noopener noreferrer" }
		: {}}
	data-astro-prefetch={false}
>
	<PictureElement
		class:list={[
			{
				"h-full object-contain": content,
				"h-full w-full object-cover": banner,
			},
			`ph thumb-box bg-cover text-[0px] backdrop-blur-2xl
			in-[.full-bleed]:h-full in-[.full-bleed]:w-auto`,
			className,
		]}
		style={`--ph: url("${lqip.src}"); --phw: ${lqipWidth}px; --phh: ${lqipHeight}px; --phar: ${aspectRatio};`}
		{...srcsetProps}
		formats={["avif", "webp"]}
		loading={props.priority ? "eager" : "lazy"}
		quality="high"
		pictureAttributes={{
			style: "mask: inherit;",
			class: "relative z-[2] lazy-image",
		}}
		{...props}
		{...hdrProps}
	/>
</Element>

<style>
	.ph {
		background-image: var(--ph);
	}
	:is(.wide, .landscape):not(.banner-clip) .thumb-box {
		width: var(--phw);
		height: auto;
		object-fit: cover;
	}
	.portrait .thumb-box {
		width: min(var(--phw), calc(var(--phar) * 500px));
		height: auto;
	}
</style>
