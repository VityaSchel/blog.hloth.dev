---
import { formatTitle } from "blog.hloth.dev-shared/src/title-formatter";

interface Props {
	title: string;
}

const { title } = Astro.props;

const formattedTitle = formatTitle(title);
---

<h1
	class="one-storey-a leading-tighter line-clamp-3 font-display text-3xl
		font-semibold tracking-tight wrap-anywhere md:text-6xl"
	title={formattedTitle.title}
>
	{
		formattedTitle.segments.map((segment) =>
			segment.emphasized ? (
				<span
					class="optical-sizing-none font-serif font-semibold italic"
					set:text={segment.text}
				/>
			) : (
				segment.text
			),
		)
	}
</h1>
