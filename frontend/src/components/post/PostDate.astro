---
import { formatLongDateTime } from "$lib/date-formatter";

interface Props {
	date: Date;
}
const { date } = Astro.props;
---

<div class="text-[#a3a3a3] dark:text-[#4b5563]">
	<span class="font-display font-semibold">
		<slot />
	</span>
	<time datetime={date.toISOString()} title={formatLongDateTime(date)}>
		{
			Intl.DateTimeFormat("en-US", {
				day: "numeric",
				month: "long",
				...(date.getFullYear() !== new Date().getFullYear() && {
					year: "numeric",
				}),
			}).format(date)
		}
	</time>
</div>
