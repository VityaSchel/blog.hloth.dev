---
import {
	formatLongDateTime,
	formatShortDate,
} from "blog.hloth.dev-shared/src/date-formatter";

interface Props {
	date: Date;
}
const { date } = Astro.props;
---

<div class="text-[#a3a3a3] dark:text-[#4b5563]">
	<span class="font-display font-semibold">
		<slot />
	</span>
	<time datetime={date.toISOString()} title={formatLongDateTime(date)}>
		{formatShortDate(date)}
	</time>
</div>
